// NAT lab: two Linux routers do masquerade NAT between each node's LAN and a
// WAN segment that holds the lighthouse. Proves hole punching through two
// real netfilter NATs, and relay fallback.
import <vmlab.wcl>

lab "ig-nat" {

  segment "wan"   { subnet = "10.99.0.0/24" }
  segment "lan-a" { subnet = "10.81.0.0/24" }
  segment "lan-b" { subnet = "10.82.0.0/24" }

  vm "lh" {
    template = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-24.04"
    arch     = "x86_64"
    cpus     = 1
    memory   = 1GiB
    nic { segment = "wan" ip = "10.99.0.10" }
  }

  // Routers own the first usable address of their LAN and take over the
  // gateway role, so the nodes' default route points at them.
  vm "rta" {
    template = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-24.04"
    arch     = "x86_64"
    cpus     = 1
    memory   = 1GiB
    nic { segment = "lan-a" ip = "10.81.0.1" gateway = true }
    nic { segment = "wan"   ip = "10.99.0.2" }
  }

  vm "rtb" {
    template = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-24.04"
    arch     = "x86_64"
    cpus     = 1
    memory   = 1GiB
    nic { segment = "lan-b" ip = "10.82.0.1" gateway = true }
    nic { segment = "wan"   ip = "10.99.0.3" }
  }

  vm "alpha" {
    template = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-24.04"
    arch     = "x86_64"
    cpus     = 1
    memory   = 1GiB
    nic { segment = "lan-a" ip = "10.81.0.11" }
  }

  vm "bravo" {
    template = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-24.04"
    arch     = "x86_64"
    cpus     = 1
    memory   = 1GiB
    nic { segment = "lan-b" ip = "10.82.0.11" }
  }
}
